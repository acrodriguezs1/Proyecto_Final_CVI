void Tutorial21_RayTracing::CreateGLTFBLAS()
{
    const auto& mesh = obj.Meshes[0];
    const auto& primitive = mesh.Primitives[0];

    // Obtener datos de vértices
    const auto& posAccessor = obj.Accessors[primitive.PositionAccessor];
    const auto& posView = obj.BufferViews[posAccessor.BufferView];
    const float* posData = reinterpret_cast<const float*>(
        &obj.Buffers[posView.Buffer].Data[posView.ByteOffset + posAccessor.ByteOffset]);

    std::vector<float3> Positions;
    Positions.reserve(posAccessor.Count);
    for (Uint32 i = 0; i < posAccessor.Count; ++i)
    {
        Positions.emplace_back(
            posData[i * 3 + 0],
            posData[i * 3 + 1],
            posData[i * 3 + 2]);
    }

    // Crear buffer de vértices
    {
        BufferDesc BuffDesc;
        BuffDesc.Name = "GLTF Vertex Buffer";
        BuffDesc.Usage = USAGE_IMMUTABLE;
        BuffDesc.BindFlags = BIND_VERTEX_BUFFER | BIND_RAY_TRACING;
        BuffDesc.Size = Positions.size() * sizeof(float3);

        BufferData BufData{ Positions.data(), BuffDesc.Size };
        m_pDevice->CreateBuffer(BuffDesc, &BufData, &m_GLTFVertexBuffer);
    }

    // Obtener datos de índices
    const auto& indexAccessor = obj.Accessors[primitive.IndicesAccessor];
    const auto& indexView = obj.BufferViews[indexAccessor.BufferView];
    const void* indexData = &obj.Buffers[indexView.Buffer].Data[indexView.ByteOffset + indexAccessor.ByteOffset];

    std::vector<Uint32> Indices;
    Indices.reserve(indexAccessor.Count);

    if (indexAccessor.ComponentType == VT_UINT16)
    {
        const Uint16* idx = reinterpret_cast<const Uint16*>(indexData);
        for (Uint32 i = 0; i < indexAccessor.Count; ++i)
            Indices.push_back(idx[i]);
    }
    else if (indexAccessor.ComponentType == VT_UINT32)
    {
        const Uint32* idx = reinterpret_cast<const Uint32*>(indexData);
        for (Uint32 i = 0; i < indexAccessor.Count; ++i)
            Indices.push_back(idx[i]);
    }

    // Crear buffer de índices
    {
        BufferDesc BuffDesc;
        BuffDesc.Name = "GLTF Index Buffer";
        BuffDesc.Usage = USAGE_IMMUTABLE;
        BuffDesc.BindFlags = BIND_INDEX_BUFFER | BIND_RAY_TRACING;
        BuffDesc.Size = Indices.size() * sizeof(Uint32);

        BufferData BufData{ Indices.data(), BuffDesc.Size };
        m_pDevice->CreateBuffer(BuffDesc, &BufData, &m_GLTFIndexBuffer);
    }

    // Crear y construir BLAS
    {
        BLASTriangleDesc Triangles;
        Triangles.GeometryName = "GLTF Model";
        Triangles.MaxVertexCount = static_cast<Uint32>(Positions.size());
        Triangles.VertexValueType = VT_FLOAT32;
        Triangles.VertexComponentCount = 3;
        Triangles.MaxPrimitiveCount = static_cast<Uint32>(Indices.size() / 3);
        Triangles.IndexType = VT_UINT32;

        BottomLevelASDesc ASDesc;
        ASDesc.Name = "GLTF BLAS";
        ASDesc.Flags = RAYTRACING_BUILD_AS_PREFER_FAST_TRACE;
        ASDesc.pTriangles = &Triangles;
        ASDesc.TriangleCount = 1;

        m_pDevice->CreateBLAS(ASDesc, &m_pGLTFBLAS);

        RefCntAutoPtr<IBuffer> pScratchBuffer;
        {
            BufferDesc BuffDesc;
            BuffDesc.Name = "BLAS Scratch";
            BuffDesc.Usage = USAGE_DEFAULT;
            BuffDesc.BindFlags = BIND_RAY_TRACING;
            BuffDesc.Size = m_pGLTFBLAS->GetScratchBufferSizes().Build;
            m_pDevice->CreateBuffer(BuffDesc, nullptr, &pScratchBuffer);
        }

        BLASBuildTriangleData TriData;
        TriData.GeometryName = "GLTF Model";
        TriData.pVertexBuffer = m_GLTFVertexBuffer;
        TriData.VertexStride = sizeof(float3);
        TriData.VertexCount = static_cast<Uint32>(Positions.size());
        TriData.VertexValueType = VT_FLOAT32;
        TriData.VertexComponentCount = 3;
        TriData.pIndexBuffer = m_GLTFIndexBuffer;
        TriData.PrimitiveCount = static_cast<Uint32>(Indices.size() / 3);
        TriData.IndexType = VT_UINT32;
        TriData.Flags = RAYTRACING_GEOMETRY_FLAG_OPAQUE;

        BuildBLASAttribs Attribs;
        Attribs.pBLAS = m_pGLTFBLAS;
        Attribs.pTriangleData = &TriData;
        Attribs.TriangleDataCount = 1;
        Attribs.pScratchBuffer = pScratchBuffer;
        Attribs.BLASTransitionMode = RESOURCE_STATE_TRANSITION_MODE_TRANSITION;
        Attribs.GeometryTransitionMode = RESOURCE_STATE_TRANSITION_MODE_TRANSITION;
        Attribs.ScratchBufferTransitionMode = RESOURCE_STATE_TRANSITION_MODE_TRANSITION;

        m_pImmediateContext->BuildBLAS(Attribs);
    }
}

